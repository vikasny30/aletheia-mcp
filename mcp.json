{
  "$schema": "https://modelcontextprotocol.io/schema/server-manifest.json",
  "name": "aletheia-mcp",
  "displayName": "Aletheia Runtime Safety & Scope Creep Filter",
  "description": "Sub-millisecond runtime safety interceptor & Signature S3 (Scope Creep) filter for AI agent tool calls. Blocks destructive actions, credential exfiltration, and out-of-boundary mutations before execution.",
  "version": "0.2.0",
  "author": "Vikas Shivpuriya <vikas.ny30@gmail.com>",
  "homepage": "https://github.com/vikasny30/aletheia-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikasny30/aletheia-mcp.git"
  },
  "license": "Apache-2.0",
  "category": "security",
  "transport": "stdio",
  "runtime": "node",
  "command": "aletheia-mcp",
  "tags": [
    "security",
    "safety",
    "agent-runtime",
    "guardrails",
    "scope-creep",
    "anthropic",
    "claude-code"
  ],
  "tools": [
    "aletheia_set_mandate",
    "aletheia_get_mandate",
    "aletheia_intercept",
    "aletheia_safe_bash",
    "aletheia_safe_sql",
    "aletheia_get_telemetry"
  ],
  "resources": [
    "aletheia://telemetry/summary",
    "aletheia://telemetry/audit-log",
    "aletheia://signatures/s3",
    "aletheia://mandate/current"
  ],
  "prompts": [
    "aletheia_mandate_enforcer"
  ]
}
